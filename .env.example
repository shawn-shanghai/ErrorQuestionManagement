# ExamCenter 环境变量配置
# 复制此文件为 .env 并填写实际值

# 数据库配置
DB_USER=examcenter
DB_PASSWORD=change_me_strong_password
DB_NAME=examcenter

# JWT 密钥（生成方式：python -c "import secrets; print(secrets.token_hex(32))"）
SECRET_KEY=change_me_to_random_32_hex_string

# 图片上传路径（容器内路径，映射到宿主机 /data/uploads）
UPLOAD_PATH=/data/uploads

# CORS 允许的前端域名（生产环境改为实际域名）
# CORS_ORIGINS=["https://yourdomain.com","https://yourdomain.com/admin"]
