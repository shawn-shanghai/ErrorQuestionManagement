# ExamCenter environment variables configuration
# Copy this file to .env and fill in actual values

# Database configuration
DB_USER=examcenter
DB_PASSWORD=change_me_strong_password
DB_NAME=examcenter

# JWT secret key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change_me_to_random_32_hex_string

# Image upload path (container path, mapped to host /data/uploads)
UPLOAD_PATH=/data/uploads

# CORS allowed frontend domains
# CORS_ORIGINS=["https://bmnew.com","https://bmnew.com/admin"]
